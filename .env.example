# Copy this file to .env and fill in real values. Never commit .env.

# ── Database (required) ──────────────────────────────────────────────────────
ORYCMS_DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# ── App URL (optional) ───────────────────────────────────────────────────────
# Used to build absolute links (e.g. password-reset links) when there's no
# request to infer an origin from. Defaults to the incoming request's origin.
ORYCMS_APP_URL=http://localhost:3000

# ── Email — SMTP (optional) ──────────────────────────────────────────────────
# Reset/invite/activation links are delivered by email only. If SMTP is not
# configured, links are printed to the server console outside production
# (never returned in an API response) and a warning is logged in production.
#
# Alternatively, set `email.provider: "smtp"` plus an `email.options` block
# in orycms.config.ts instead of (or alongside) these env vars — env vars win.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (typically port 465), "false" for STARTTLS
# (typically port 587). Defaults to true only when SMTP_PORT is 465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Default "From" address, e.g. "OryCMS <no-reply@example.com>"
SMTP_FROM=

# ── Email provider selection (optional) ──────────────────────────────────────
# "smtp" or "custom" (a custom provider is supplied via orycms.config.ts's
# email.options.send). Can also be set via orycms.config.ts's email.provider.
ORYCMS_EMAIL_PROVIDER=smtp
ORYCMS_EMAIL_FROM=
